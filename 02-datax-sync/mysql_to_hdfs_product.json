                        "connection": [
                            {
                                "querySql": [
                                    "SELECT product_id, product_name, category, brand, price, cost, stock, launch_date, DATE_FORMAT(create_time,'%Y-%m-%d %H:%i:%s') AS create_time FROM ecommerce.dim_product"
